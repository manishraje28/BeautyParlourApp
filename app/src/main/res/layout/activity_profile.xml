<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ═══ Curved Pink Header ═══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_header_curved"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingTop="32dp"
                android:paddingBottom="36dp">

                <TextView
                    style="@style/AppHeaderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="My Profile" />

                <TextView
                    style="@style/AppHeaderSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Your beauty journey" />
            </LinearLayout>

            <!-- ═══ Profile Content ═══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="16dp">

                <!-- ── Logged Out State ── -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/layout_logged_out"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="visible"
                    app:cardBackgroundColor="@color/surface_card"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="28dp">

                        <!-- Empty state icon -->
                        <ImageView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:layout_gravity="center_horizontal"
                            android:contentDescription="Not logged in"
                            android:src="@drawable/ic_scissors"
                            android:tint="@color/primary_pink" />

                        <TextView
                            style="@style/AppSectionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="center"
                            android:text="You are not logged in" />

                        <TextView
                            style="@style/AppBodyText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="Sign in to access your profile and bookings" />

                        <Button
                            android:id="@+id/btn_go_login"
                            style="@style/AppPrimaryButton"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:paddingVertical="12dp"
                            android:layout_marginTop="20dp"
                            android:text="Login" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- ── Logged In State ── -->
                <LinearLayout
                    android:id="@+id/layout_logged_in"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Avatar Card -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/surface_card"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="4dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:padding="28dp">

                            <!-- Avatar with gold ring and edit button -->
                            <FrameLayout
                                android:layout_width="108dp"
                                android:layout_height="108dp">

                                <!-- Gold ring -->
                                <View
                                    android:layout_width="108dp"
                                    android:layout_height="108dp"
                                    android:background="@drawable/bg_avatar_ring" />

                                <!-- Gesture 5: Pinch Zoom target -->
                                <ImageView
                                    android:id="@+id/img_avatar"
                                    android:layout_width="96dp"
                                    android:layout_height="96dp"
                                    android:layout_gravity="center"
                                    android:background="@drawable/bg_profile_placeholder"
                                    android:scaleType="centerCrop" />

                                <!-- Tap to pick a new photo from gallery -->
                                <TextView
                                    android:id="@+id/btn_change_photo"
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:layout_gravity="bottom|end"
                                    android:background="@drawable/bg_change_photo_circle"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:gravity="center"
                                    android:text="&#10000;"
                                    android:textColor="@color/white"
                                    android:textSize="13sp" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/tv_profile_name"
                                style="@style/AppSectionTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:text="Name" />

                            <TextView
                                android:id="@+id/tv_profile_email"
                                style="@style/AppBodyText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="email@example.com" />

                            <!-- Gold divider -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="20dp"
                                android:background="@drawable/bg_gold_divider" />

                            <Button
                                android:id="@+id/btn_logout"
                                style="@style/AppPrimaryButton"
                                android:layout_width="match_parent"
                                android:layout_height="60dp"
                                android:paddingVertical="10dp"
                                android:layout_marginTop="20dp"
                                android:text="Logout" />

                            <!-- <Button
                                android:id="@+id/btn_view_users"
                                style="@style/AppSecondaryButton"
                                android:layout_width="match_parent"
                                android:layout_height="60dp"
                                android:paddingVertical="10dp"
                                android:layout_marginTop="12dp"
                                android:text="View All Users" /> -->
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <!-- Gesture 4: Swipe Left/Right hint -->
                <TextView
                    style="@style/AppBodyText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="28dp"
                    android:alpha="0.45"
                    android:gravity="center"
                    android:text="← Swipe left to Book  |  Swipe right for Home →"
                    android:textSize="12sp" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/footer_container"
        android:layout_width="match_parent"
        android:layout_height="72dp" />

</LinearLayout>
