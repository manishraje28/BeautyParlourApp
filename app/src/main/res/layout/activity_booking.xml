<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA">

    <!-- Gradient Background -->
    <View
        android:id="@+id/v_top_gradient"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:background="@drawable/bg_booking_header_gradient"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top Bar with Back Button -->
    <LinearLayout
        android:id="@+id/ll_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="24dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">
        
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_back_white_24dp"
            app:tint="#FFFFFF"
            tools:ignore="UseAppTint" />
            
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Booking"
            android:textAlignment="center"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginEnd="24dp" /> <!-- Compensate for back button to center text -->
    </LinearLayout>

    <!-- Timeline Stepper -->
    <LinearLayout
        android:id="@+id/ll_stepper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="40dp"
        android:paddingTop="10dp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/ll_top_bar">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Service"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:layout_width="40dp"
            android:layout_height="1dp"
            android:layout_marginHorizontal="10dp"
            android:background="#FFFFFF"
            android:alpha="0.5" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Date &amp; Time"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:layout_width="40dp"
            android:layout_height="1dp"
            android:layout_marginHorizontal="10dp"
            android:background="#FFFFFF"
            android:alpha="0.5" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Confirm"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:alpha="0.7" />
    </LinearLayout>

    <!-- White Bottom Sheet Content -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/bg_booking_sheet"
        android:padding="28dp"
        app:layout_constraintTop_toBottomOf="@id/ll_stepper"
        app:layout_constraintBottom_toTopOf="@id/footer_container">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:scrollbars="none"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/btn_book">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select Service"
                    android:textColor="#222222"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Gold line decorative -->
                <View
                    android:layout_width="30dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="16dp"
                    android:background="#CA9F51" />

                <Spinner
                    android:id="@+id/spinner_service"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_spinner_stroke"
                    android:paddingHorizontal="16dp"
                    android:layout_marginBottom="24dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select Date"
                    android:textColor="#222222"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="30dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="16dp"
                    android:background="#CA9F51" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_rounded_card"
                    android:padding="20dp"
                    android:orientation="vertical"
                    android:elevation="2dp"
                    android:layout_marginBottom="24dp">

                    <Button
                        android:id="@+id/btn_pick_date"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:background="@drawable/bg_secondary_btn_stroke"
                        android:text="📅 Choose Date"
                        android:textColor="#B68846"
                        android:textSize="14sp"
                        app:backgroundTint="@null" />

                    <TextView
                        android:id="@+id/tv_selected_date"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Not selected"
                        android:textAlignment="center"
                        android:textColor="#757575"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select Time"
                    android:textColor="#222222"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="30dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="16dp"
                    android:background="#CA9F51" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_rounded_card"
                    android:padding="20dp"
                    android:orientation="vertical"
                    android:elevation="2dp"
                    android:layout_marginBottom="24dp">

                    <Button
                        android:id="@+id/btn_pick_time"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:background="@drawable/bg_secondary_btn_stroke"
                        android:text="⏰ Choose Time"
                        android:textColor="#B68846"
                        android:textSize="14sp"
                        app:backgroundTint="@null" />

                    <TextView
                        android:id="@+id/tv_selected_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Not selected"
                        android:textAlignment="center"
                        android:textColor="#757575"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <Button
            android:id="@+id/btn_book"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/bg_booking_btn_confirm"
            app:backgroundTint="@null"
            android:text="Confirm Booking"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/footer_container"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>