<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#F8F8F8">

    <!-- Using AdjustViewBounds allows it to scale nicely maintaining aspect ratio -->
    <ImageView
        android:id="@+id/iv_gallery_image"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true" />

    <!-- Optional remove button for admin -->
    <ImageView
        android:id="@+id/iv_delete_gallery"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_close"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:padding="6dp"
        android:background="@drawable/bg_avatar_ring"
        android:visibility="gone"
        app:tint="@android:color/white" />

</androidx.cardview.widget.CardView>