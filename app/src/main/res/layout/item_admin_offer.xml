<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tv_offer_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="New Client Welcome"
            android:textColor="#9E2A2B"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_offer_validity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Ongoing"
            android:textColor="#F28482"
            android:textSize="12sp"
            android:textStyle="italic" />

        <!-- Promo Code Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_dash_border_gold"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp">

            <TextView
                android:id="@+id/tv_offer_code"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="GLOWUP"
                android:textColor="#D89A29"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_offer_discount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$15 OFF"
                android:textColor="#9E2A2B"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:background="#F5F5F5" />

        <!-- Edit/Delete Action Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_edit_offer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawableLeft="@drawable/ic_pencil_gold"
                android:drawablePadding="8dp"
                android:drawableTint="#D81B60"
                android:gravity="center"
                android:text="EDIT"
                android:textColor="#D81B60"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_delete_offer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawableLeft="@drawable/ic_nav_home"
                android:drawablePadding="8dp"
                android:drawableTint="#F28482"
                android:gravity="center"
                android:text="DELETE"
                android:textColor="#F28482"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <!-- Active Badge -> Can be positioned top right natively later -->
    <TextView
        android:id="@+id/tv_active_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top"
        android:background="@drawable/bg_active_badge"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:text="ACTIVE"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:textStyle="bold" />

</androidx.cardview.widget.CardView>