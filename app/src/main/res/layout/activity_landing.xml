<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingHorizontal="24dp">

    <!-- Logo/Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/salon_name"
        android:textSize="48sp"
        android:textStyle="bold"
        android:textColor="@color/primary_pink"
        android:layout_marginBottom="16dp" />

    <!-- Tagline -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/salon_tagline"
        android:textSize="18sp"
        android:textColor="@color/text_secondary"
        android:textAlignment="center"
        android:layout_marginBottom="48dp" />

    <!-- Description -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Experience beauty and relaxation at our premium salon. Book appointments, explore services, and enjoy exclusive offers."
        android:textSize="16sp"
        android:textColor="@color/text_primary"
        android:textAlignment="center"
        android:layout_marginBottom="64dp"
        android:lineSpacingMultiplier="1.4" />

    <!-- Enter Salon Button -->
    <Button
        android:id="@+id/btn_next"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/enter_salon"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:background="@drawable/bg_button_rounded"
        android:layout_marginBottom="16dp" />

</LinearLayout>
